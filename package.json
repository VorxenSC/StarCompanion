{
  "name": "star-companion",
  "productName": "Star Companion",
  "version": "0.4.6",
  "description": "In-game search overlay for Star Citizen: items, ships, blueprints, missions and minerals.",
  "author": "Vorxen",
  "repository": "github:VorxenSC/StarCompanion",
  "main": "app/main.js",
  "private": true,
  "scripts": {
    "start": "node scripts/build-keys.js && electron .",
    "collect:craft": "node scripts/collect-craft.js",
    "collect:miner": "node scripts/collect-miner.js",
    "collect:cstone": "node scripts/collect-cstone.js",
    "collect:wiki": "node scripts/collect-wiki.js",
    "collect:ships": "node scripts/collect-ships.js",
    "collect:market": "node scripts/collect-market.js",
    "collect:commodities": "node scripts/collect-commodities.js",
    "build:db": "node scripts/build-db.js",
    "update-data": "node scripts/update-all.js",
    "icon": "electron scripts/make-icon.js",
    "dist": "node scripts/build-keys.js && electron-builder --win nsis",
    "test": "node --test test/*.test.js"
  },
  "build": {
    "appId": "space.starcompanion.overlay",
    "productName": "Star Companion",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**",
      "scripts/**",
      "package.json",
      "!scripts/probe-blobs.js"
    ],
    "asar": false,
    "publish": [
      {
        "provider": "github",
        "owner": "VorxenSC",
        "repo": "StarCompanion"
      }
    ],
    "win": {
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "StarCompanion-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Star Companion",
      "uninstallDisplayName": "Star Companion by Vorxen",
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
